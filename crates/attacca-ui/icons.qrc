        <file alias="volume.svg">assets/volume.svg</file>
        <file alias="note.svg">assets/note.svg</file>
        <file alias="link.svg">assets/link.svg</file>
        <file alias="shuffle.svg">assets/shuffle.svg</file>
        <file alias="repeat.svg">assets/repeat.svg</file>
